PORT=3001

# OpenRouter generates one read-only SQL query from each plain-language request.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional provider slug (for example, openai or anthropic). When set, fallback
# to other providers is disabled.
OPENROUTER_PROVIDER=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_COMPLETION_TOKENS=2000
OPENROUTER_TIMEOUT_MS=30000

# Use a dedicated PostgreSQL role with SELECT-only permissions.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=dota_stats_reader
PGPASSWORD=
PGSCHEMA=public
